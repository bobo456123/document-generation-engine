{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build:workspace": {
      "outputs": ["dist/**"]
    },
    "lint:workspace": {},
    "typecheck:workspace": {},
    "test:workspace": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
