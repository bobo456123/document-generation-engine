{
  "name": "document-generation-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build:workspace --filter=document-generation-engine",
    "build:workspace": "tsc -p tsconfig.build.json",
    "dev": "tsx apps/cli/src/main.ts",
    "dev:server": "tsx apps/server/src/main.ts",
    "bizdoc": "tsx apps/cli/src/main.ts",
    "lint": "turbo run lint:workspace --filter=document-generation-engine",
    "lint:workspace": "eslint .",
    "typecheck": "turbo run typecheck:workspace --filter=document-generation-engine",
    "typecheck:workspace": "tsc -p tsconfig.json --noEmit",
    "test": "turbo run test:workspace --filter=document-generation-engine",
    "test:workspace": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.41",
    "@ai-sdk/openai": "^4.0.45",
    "@ai-sdk/openai-compatible": "^3.0.34",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@vue/compiler-sfc": "^3.5.20",
    "ai": "^7.0.74",
    "better-sqlite3": "^12.2.0",
    "commander": "^14.0.1",
    "drizzle-orm": "^0.44.5",
    "fast-glob": "^3.3.3",
    "image-size": "^2.0.2",
    "marked": "^18.0.10",
    "pino": "^9.9.0",
    "reflect-metadata": "^0.2.2",
    "tree-sitter": "0.21.1",
    "tree-sitter-java": "^0.23.5",
    "ts-morph": "^27.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
